# Research Studio — local operator config
# Copy to .env.local and fill in what you have.

# Optional: higher-quality research + scripts + OpenAI TTS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# TTS provider preference: openai (default when key present) or edge
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural

# TikTok Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional override; defaults to {origin}/api/accounts/tiktok/callback
TIKTOK_REDIRECT_URI=
# Force local demo posts even when TikTok is configured
TIKTOK_DEMO_POST=1
